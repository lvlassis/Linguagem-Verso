# Almanaque de Sentimentos
# Um poema sobre os fragmentos que habitam o coração

# ── int almanaque[] = {7, 6, 7, 5} ──────────────────────────────
# firmeza=7, leveza=6, saudade=7, ainda=5
que o almanaque seja um compêndio rochoso com firmeza, leveza, saudade, ainda.

# ── float paleta[] = {5, 4} ──────────────────────────────────────
# breve=5, leve=4
que a paleta seja um compêndio enevoado com breve, leve.

# ── char rascunho[4]; ─────────────────────────────────────────────
# amor=4 letras
que o rascunho seja um compêndio traçado de amor.

# ── char* cancioneiro[7]; ─────────────────────────────────────────
# saudade=7 letras
que o cancioneiro seja um compêndio versejado de saudade.

# ── bool conflito[5]; ────────────────────────────────────────────
# ainda=5 letras
que o conflito seja um compêndio dúbio de ainda.

# ── int notas[] = {4, 3, 10} — valores literais ──────────────────
que o caderno seja um compêndio rochoso com 4, 3, 10.

# ── narrativa ────────────────────────────────────────────────────
que o canto seja verso.
digo que o almanaque foi gravado.
escuto o canto.
digo que o canto ecoou.
